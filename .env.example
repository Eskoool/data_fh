# Configuración de la aplicación
APP_TITLE="Análisis de Datos Farmacéuticos"
APP_DESCRIPTION="Sistema de análisis estadístico local compatible con RGPD"

# Ollama configuration (servidor local de IA)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Opciones de análisis
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Configuración de seguridad RGPD
DATA_RETENTION_DAYS=0
AUTO_DELETE_UPLOADS=true
